# EAS auth token (CI builds/submits).
EXPO_TOKEN=

# Environment selection. Chooses the Firebase project + backend URL + native config
# (see app.config.ts): development|staging → durin-seli-dev, production → japa-platform.
# EAS build profiles set this automatically (see eas.json); for local runs it
# defaults to `development` (deployed durin-seli-dev). Override to test prod locally.
# APP_ENV=development

# Opt into the LOCAL Firebase emulator suite (functions + auth) instead of the
# deployed backend. Leave unset/false to hit the deployed durin-seli-dev backend.
# EXPO_PUBLIC_USE_EMULATOR=true
