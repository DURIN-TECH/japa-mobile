{
  "extends": "expo/tsconfig.base",
  "module": "commonjs",
  "compilerOptions": {
    // Strict Typechencking
    "strict": true,

    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}