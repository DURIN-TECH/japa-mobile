{
  "extends": "expo/tsconfig.base",
  "module": "commonjs",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",

    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "pre-commit-config.yaml",
    "prettier.config.js"
  ]
}
