{
  "name": "japa-mobile",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "clean": "rm -rf node_modules && rm package-lock.json && rm -rf ios/build && rm -rf android/app/build && rm -rf ios/Pods && rm -rf ios/.expo && rm -rf android/.expo && rm -rf ios/.expo-shared && rm -rf android/.expo-shared",
    "prebuild": "npx expo prebuild --clean",
    "pod:install": "cd ios && pod install && cd ..",
    "pod:update": "cd ios && pod update && cd ..",
    "pod:clean": "cd ios && pod deintegrate && pod cache clean --all && pod repo update && cd ..",
    "start": "expo start",
    "build:dev": "eas build --profile development --platform all",
    "build:prod": "eas build --profile production --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "build:preview:android": "eas build --profile preview --platform android",
    "submit:prod": "eas submit --platform all",
    "submit:prod:ios": "eas submit --platform ios",
    "submit:prod:android": "eas submit --platform android",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "test": "jest --watchAll",
    "lint": "eslint . --ignore-pattern .gitignore --fix",
    "prepare": "[[ -f .git/hooks/pre-commit ]] && pre-commit install || true"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@eslint/compat": "1.2.4",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/analytics": "24.0.0",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/auth": "24.0.0",
    "@react-native-firebase/crashlytics": "24.0.0",
    "@react-native-firebase/messaging": "24.0.0",
    "@tanstack/react-query": "5.90.20",
    "axios": "1.16.1",
    "date-fns": "4.1.0",
    "expo": "~56.0.8",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.16",
    "expo-constants": "~56.0.16",
    "expo-dev-client": "~56.0.18",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.8",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.17",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^0.562.0",
    "nativewind": "4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "3.4.15",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "9.39.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.17.0",
    "@typescript-eslint/parser": "8.17.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.37.2",
    "globals": "15.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.4",
    "lint-staged": "15.5.2",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "react-test-renderer": "19.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.17.0"
  },
  "lint-staged": {
    "./src/**/*.{js, jsx, ts, tsx}": [
      "npm run lint",
      "bash -c tsc -p tsconfig.json --noEmit --emotDeclarationOnly false"
    ]
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
