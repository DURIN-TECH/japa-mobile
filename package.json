{
  "name": "japa-mobile",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "build:dev": "eas build --profile development --platform all",
    "build:prod": "eas build --profile production --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "build:preview:android": "eas build --profile preview --platform android",
    "submit:prod": "eas submit --platform all",
    "submit:prod:ios": "eas submit --platform ios",
    "submit:prod:android": "eas submit --platform android",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "test": "jest --watchAll",
    "lint": "eslint . --ignore-pattern .gitignore --fix",
    "prepare": "[[ -f .git/hooks/pre-commit ]] && pre-commit install || true"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@eslint/compat": "^1.2.4",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-firebase/app": "^21.6.1",
    "@react-native-firebase/auth": "^21.6.1",
    "@react-native-firebase/crashlytics": "^21.6.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "date-fns": "^4.1.0",
    "expo": "~52.0.31",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-splash-screen": "~0.29.21",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.8",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^0.462.0",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "tailwindcss": "^3.4.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.16.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.17.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "./src/**/*.{js, jsx, ts, tsx}": [
      "npm run lint",
      "bash -c tsc -p tsconfig.json --noEmit --emotDeclarationOnly false"
    ]
  },
  "private": true
}
