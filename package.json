{
  "name": "japa-mobile",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf ios/build && rm -rf android/app/build && rm -rf ios/Pods && rm -rf ios/.expo && rm -rf android/.expo && rm -rf ios/.expo-shared && rm -rf android/.expo-shared",
    "prebuild": "npx expo prebuild --clean",
    "pod:install": "cd ios && pod install && cd ..",
    "pod:update": "cd ios && pod update && cd ..",
    "pod:clean": "cd ios && pod deintegrate && pod cache clean --all && pod repo update && cd ..",
    "start": "expo start",
    "build:dev": "eas build --profile development --platform all",
    "build:prod": "eas build --profile production --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "build:preview:android": "eas build --profile preview --platform android",
    "submit:prod": "eas submit --platform all",
    "submit:prod:ios": "eas submit --platform ios",
    "submit:prod:android": "eas submit --platform android",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "test": "jest --watchAll",
    "lint": "eslint . --ignore-pattern .gitignore --fix",
    "prepare": "[[ -f .git/hooks/pre-commit ]] && pre-commit install || true"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@eslint/compat": "1.2.4",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/auth": "^23.7.0",
    "@react-native-firebase/crashlytics": "^23.7.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "2.3.1",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "5.90.20",
    "axios": "1.13.3",
    "date-fns": "4.1.0",
    "expo": "~53.0.25",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.10",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "lucide-react-native": "^0.562.0",
    "nativewind": "4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "tailwindcss": "3.4.15",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "9.16.0",
    "@types/jest": "29.5.12",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.17.0",
    "@typescript-eslint/parser": "8.17.0",
    "eslint": "9.16.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "7.37.2",
    "globals": "15.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.5",
    "lint-staged": "15.2.10",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.17.0"
  },
  "lint-staged": {
    "./src/**/*.{js, jsx, ts, tsx}": [
      "npm run lint",
      "bash -c tsc -p tsconfig.json --noEmit --emotDeclarationOnly false"
    ]
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
